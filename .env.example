# JWT Secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# URL pública base del panel — usada para construir enlaces enviados por correo
# (ej. establecer/restablecer contraseña: `${APP_URL}/auth/set-password?token=...`).
APP_URL="http://localhost:3000"

# Supabase Postgres — Prisma runtime (PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — Prisma migrations (direct port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.qzzjpyepggwautckqeex.supabase.co:5432/postgres"

# Supabase Storage — product images (server-side only, never expose to browser)
SUPABASE_URL="https://qzzjpyepggwautckqeex.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Facturama — CFDI 4.0 via PAC Facturama
# Sandbox:    https://apisandbox.facturama.mx/
# Producción: https://api.facturama.mx/
FACTURAMA_BASE_URL="https://apisandbox.facturama.mx/"
# Credenciales Facturama (Basic Auth). Dejar vacío mientras se obtienen las reales.
FACTURAMA_USER="facturama_user"
FACTURAMA_PASSWORD="facturama_password"
# FACTURAMA_MOCK=true  →  usa FakeFacturamaGateway (sin red, UUIDs simulados). Default: true.
FACTURAMA_MOCK="true"
# DEPRECADAS (change emitter-fiscal-settings) — el emisor del Carta Porte (waybills-api) ya no se
# lee de estas env vars. Se captura/edita en BD vía /billing (pantalla de carga de CSD) y se persiste
# en la tabla `emitter_fiscal_settings` (src/shared/infrastructure/emitter/). Dejar sin efecto aquí.
# FACTURAMA_EMITTER_RFC="XAXX010101000"
# FACTURAMA_EMITTER_NAME="Agrisas"
# FACTURAMA_EMITTER_FISCAL_REGIME="601"
# FACTURAMA_EMITTER_ZIP_CODE="83000"

# SMTP — envío de correo (factura por email + notificaciones admin). Todas opcionales:
# su ausencia deshabilita el envío correspondiente sin romper el arranque del servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Agrisas <no-reply@agrisas.mx>"
# Destinatario de notificaciones admin (venta cancelada, stock bajo reorder_point).
# Vacío = notificaciones admin deshabilitadas (no afecta el envío de factura por correo).
ADMIN_NOTIFICATION_EMAIL=""

# Secreto compartido para el endpoint cron de avisos de caducidad de inventario
# (POST /api/v1/admin/cron/inventory-expiry-notifications). Vercel lo inyecta
# automáticamente como "Authorization: Bearer $CRON_SECRET" en llamadas de Vercel Cron
# cuando esta env var está configurada en el proyecto. Generar con: openssl rand -hex 32
CRON_SECRET=""

# Modo de alcance del inventario. "general" (default, cualquier valor no reconocido cae aquí):
# catálogo global, comportamiento actual. "branch": el catálogo del POS/Cotizaciones sólo
# muestra productos con fila en branch_inventory de la sucursal activa (asignación explícita);
# vender/cotizar un producto no asignado falla con 400. No requiere migración — reinterpreta
# branch_inventory existente. Ver openspec/specs/inventory-api/spec.md.
INVENTORY_SCOPE_MODE="general"

# RBAC — rol por defecto asignado al nuevo usuario al registrarse.
# Opciones: admin | operator | viewer. Requerido — el servidor crashea si no está.
RBAC_DEFAULT_ROLE="viewer"

# Inyectado automáticamente por Vercel en deploys. Poner manualmente para probar
# comportamiento de producción en local (ej. analytics, banner de entorno).
# VERCEL_ENV="production"
