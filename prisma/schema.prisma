  cancelledAt           DateTime? @map("cancelled_at")
  cancelledBy           String?   @map("cancelled_by") @db.Uuid
  cancellationReason    String?   @map("cancellation_reason") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  provider         Provider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  folio            Folio             @relation(fields: [folioId], references: [id], onDelete: Restrict)
  paymentMethod    PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  creator          User              @relation("UserPurchasesCreated", fields: [creatorId], references: [id], onDelete: Restrict)
  items            PurchaseItem[]
  providerPayments ProviderPayment[]

  @@unique([folioCode])
  @@index([folioId])
  @@index([providerId])
  @@index([branchId])
  @@index([status])
  @@index([purchasedAt])
  @@map("purchases")
}

model PurchaseItem {
  id                  String   @id @default(uuid())
  purchaseId          String   @map("purchase_id")
  productId           String   @map("product_id")
  productCodeSnapshot String   @map("product_code_snapshot") @db.VarChar(32)
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(200)
  quantity            Decimal  @db.Decimal(14, 4)
  unitCost            Decimal  @map("unit_cost") @db.Decimal(12, 4)
  discountPct         Decimal? @map("discount_pct") @db.Decimal(5, 2)
  ivaRate             Decimal? @map("iva_rate") @db.Decimal(5, 4)
  iepsRate            Decimal? @map("ieps_rate") @db.Decimal(5, 4)
  lineSubtotal        Decimal  @map("line_subtotal") @db.Decimal(14, 4)
  lineTax             Decimal  @map("line_tax") @db.Decimal(14, 4)
  lineTotal           Decimal  @map("line_total") @db.Decimal(14, 4)

  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryLots InventoryLot[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryLot {
  id                    String    @id @default(uuid())
  branchId              String    @map("branch_id")
  productId             String    @map("product_id")
  purchaseItemId        String    @map("purchase_item_id")
  lotNumber             String    @map("lot_number") @db.VarChar(64)
  expirationDate        DateTime  @map("expiration_date") @db.Date
  manufactureDate       DateTime? @map("manufacture_date") @db.Date
  quantity              Decimal   @db.Decimal(14, 4)
  createdAt             DateTime  @default(now()) @map("created_at")
  notifiedSixMonthsAt   DateTime? @map("notified_six_months_at")
  notifiedThreeMonthsAt DateTime? @map("notified_three_months_at")
  notifiedDayOfAt       DateTime? @map("notified_day_of_at")

  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@index([branchId, productId, expirationDate])
  @@map("inventory_lots")
}

model ProviderPayment {
  id                 String    @id @default(uuid())
  purchaseId         String    @map("purchase_id")
  providerId         String    @map("provider_id")
  branchId           String    @map("branch_id")
  folioId            String    @map("folio_id")
  folioNumber        Int       @map("folio_number")
  folioCode          String    @map("folio_code") @db.VarChar(40)
  creatorId          String    @map("creator_id") @db.Uuid
  amount             Decimal   @db.Decimal(14, 4)
  status             String    @default("completed") @db.VarChar(20)
  notes              String?   @db.Text
  paidAt             DateTime  @default(now()) @map("paid_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancellationReason String?   @map("cancellation_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  folio    Folio    @relation(fields: [folioId], references: [id], onDelete: Restrict)
  creator  User     @relation("UserProviderPaymentsCreated", fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([folioId, folioNumber])
  @@index([purchaseId, status])
  @@index([providerId, status])
  @@index([branchId, createdAt])
  @@map("provider_payments")
}

model Expense {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  concept     String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(14, 4)
  notes       String?  @db.Text
  photoUrl    String?  @map("photo_url")
  expenseDate DateTime @map("expense_date") @db.Date
  creatorId   String   @map("creator_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator User   @relation("UserExpensesCreated", fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([expenseDate])
  @@map("expenses")
}
