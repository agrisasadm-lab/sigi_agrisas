generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  branchId     String?  @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                   UserRole[]
  branch                  Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales                   Sale[]               @relation("UserSales")
  quotesCreated           Quote[]              @relation("UserQuotesCreated")
  quotesAuthorized        Quote[]              @relation("UserQuotesAuthorized")
  returnsCreated          Return[]             @relation("UserReturnsCreated")
  returnsCancelled        Return[]             @relation("UserReturnsCancelled")
  payments                CustomerPayment[]
  purchasesCreated        Purchase[]           @relation("UserPurchasesCreated")
  providerPaymentsCreated ProviderPayment[]    @relation("UserProviderPaymentsCreated")
  expensesCreated         Expense[]            @relation("UserExpensesCreated")
  passwordSetupTokens     PasswordSetupToken[]

  @@index([branchId])
  @@map("users")
}

model PasswordSetupToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_setup_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(32)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([key])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isCredit    Boolean  @default(false) @map("is_credit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sales     Sale[]
  payments  CustomerPayment[]
  purchases Purchase[]

  @@index([code])
  @@map("payment_methods")
}

model Folio {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(100)
  prefix        String?  @db.VarChar(8)
  scope         String   @default("OPERATIONS") @db.VarChar(32)
  currentNumber Int      @default(0) @map("current_number")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sales            Sale[]
  quotes           Quote[]
  payments         CustomerPayment[]
  waybills         Waybill[]
  movements        InventoryMovement[]
  purchases        Purchase[]
  providerPayments ProviderPayment[]
  branchCounters   FolioBranchCounter[]

  @@index([code])
  @@index([scope])
  @@map("folios")
}

/// Contador independiente por (folio, sucursal) para folios branch-scoped
/// (TK/TC/COT/CP — ver src/shared/domain/folios/BRANCH_SCOPED_FOLIO_CODES).
/// `folios.current_number` sigue existiendo para RB/AB/DEV/PP/TS, que no se
/// tocan por este modelo. Sin backfill: cada sucursal arranca en 0.
model FolioBranchCounter {
  folioId       String   @map("folio_id")
  branchId      String   @map("branch_id")
  currentNumber Int      @default(0) @map("current_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  folio  Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([folioId, branchId])
  @@index([branchId])
  @@map("folio_branch_counters")
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  providerId  String?  @map("provider_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([code])
  @@index([providerId])
  @@map("departments")
}

model Branch {
  id                    String   @id @default(uuid())
  code                  String   @unique @db.VarChar(32)
  name                  String   @db.VarChar(100)
  address               String?  @db.VarChar(300)
  phone                 String?  @db.VarChar(30)
  email                 String?  @db.VarChar(120)
  isHeadquarters        Boolean  @default(false) @map("is_headquarters")
  isActive              Boolean  @default(true) @map("is_active")
  addressStreet         String?  @map("address_street") @db.VarChar(150)
  addressExteriorNumber String?  @map("address_exterior_number") @db.VarChar(20)
  addressInteriorNumber String?  @map("address_interior_number") @db.VarChar(20)
  addressNeighborhood   String?  @map("address_neighborhood") @db.VarChar(100)
  addressMunicipality   String?  @map("address_municipality") @db.VarChar(100)
  addressState          String?  @map("address_state") @db.VarChar(3)
  addressCountry        String?  @default("MEX") @map("address_country") @db.VarChar(3)
  addressZipCode        String?  @map("address_zip_code") @db.VarChar(5)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  inventory             BranchInventory[]
  users                 User[]
  sales                 Sale[]
  quotes                Quote[]
  returns               Return[]
  payments              CustomerPayment[]
  invoices              Invoice[]
  waybillsAsOrigin      Waybill[]            @relation("WaybillOrigin")
  waybillsAsDestination Waybill[]            @relation("WaybillDestination")
  inventoryMovements    InventoryMovement[]
  purchases             Purchase[]
  providerPayments      ProviderPayment[]
  productPrices         ProductPrice[]
  printerConfig         BranchPrinterConfig?
  expenses              Expense[]
  customers             CustomerBranch[]
  folioCounters         FolioBranchCounter[]

  @@index([code])
  @@map("branches")
}

model BranchPrinterConfig {
  id          String   @id @default(uuid())
  branchId    String   @unique @map("branch_id")
  printMode   String   @default("browser") @map("print_mode") @db.VarChar(10)
  agentUrl    String?  @map("agent_url") @db.VarChar(200)
  printerHost String?  @map("printer_host") @db.VarChar(200)
  printerPort Int?     @default(9100) @map("printer_port")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("branch_printer_configs")
}

model Vehicle {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(32)
  plate            String   @db.VarChar(20)
  vehicleConfig    String   @map("vehicle_config") @db.VarChar(10)
  permitType       String   @map("permit_type") @db.VarChar(10)
  permitNumber     String   @map("permit_number") @db.VarChar(50)
  insuranceCompany String   @map("insurance_company") @db.VarChar(150)
  insurancePolicy  String   @map("insurance_policy") @db.VarChar(50)
  notes            String?  @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  waybills Waybill[]

  @@index([code])
  @@map("vehicles")
}

model Driver {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(150)
  rfc           String?  @db.VarChar(13)
  licenseNumber String   @map("license_number") @db.VarChar(50)
  notes         String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  waybills Waybill[]

  @@index([code])
  @@map("drivers")
}

model Provider {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(32)
  name           String   @db.VarChar(120)
  rfc            String?  @db.VarChar(13)
  legalName      String?  @map("legal_name") @db.VarChar(200)
  taxRegime      String?  @map("tax_regime") @db.VarChar(3)
  cfdiUse        String?  @map("cfdi_use") @db.VarChar(3)
  taxZipCode     String?  @map("tax_zip_code") @db.VarChar(5)
  email          String?  @db.VarChar(120)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(300)
  contactName    String?  @map("contact_name") @db.VarChar(120)
  notes          String?  @db.Text
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(12, 4)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(12, 4)
  initialBalance Decimal  @default(0) @map("initial_balance") @db.Decimal(12, 4)
  creditDays     Int      @default(30) @map("credit_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  departments        Department[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  providerPayments   ProviderPayment[]

  @@index([code])
  @@index([rfc])
  @@index([name])
  @@map("providers")
}

model TaxRate {
  id                        String   @id @default(uuid())
  code                      String   @unique @db.VarChar(32)
  name                      String   @db.VarChar(100)
  description               String?  @db.Text
  satTaxCode                String   @map("sat_tax_code") @db.VarChar(3)
  factorType                String   @map("factor_type") @db.VarChar(10)
  displayValue              Decimal  @map("display_value") @db.Decimal(9, 4)
  rate                      Decimal  @db.Decimal(9, 6)
  transferredAccount        String?  @map("transferred_account") @db.VarChar(20)
  pendingTransferredAccount String?  @map("pending_transferred_account") @db.VarChar(20)
  creditedAccount           String?  @map("credited_account") @db.VarChar(20)
  pendingCreditedAccount    String?  @map("pending_credited_account") @db.VarChar(20)
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([code])
  @@map("tax_rates")
}

model Product {
  id               String    @id @default(uuid())
  code             String    @unique @db.VarChar(32)
  name             String    @db.VarChar(200)
  unit             String    @db.VarChar(32)
  satProductCode   String?   @map("sat_product_code") @db.VarChar(16)
  departmentId     String    @map("department_id")
  taxRateId        String?   @map("tax_rate_id")
  ivaRate          Decimal?  @map("iva_rate") @db.Decimal(5, 4)
  iepsRate         Decimal?  @map("ieps_rate") @db.Decimal(5, 4)
  imageUrl         String?   @map("image_url") @db.Text
  manufactureDate  DateTime? @map("manufacture_date") @db.Date
  acquisitionPrice Decimal?  @map("acquisition_price") @db.Decimal(12, 4)
  isTaxable        Boolean   @default(false) @map("is_taxable")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  department    Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  taxRate       TaxRate?              @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  prices        ProductPrice[]
  dosifications ProductDosification[]
  inventory     BranchInventory[]
  saleItems     SaleItem[]
  quoteItems    QuoteItem[]
  returnItems   ReturnItem[]
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]

  @@index([code])
  @@index([name])
  @@index([departmentId])
  @@index([taxRateId])
  @@map("products")
}

model SatProductServiceCode {
  code        String   @id @db.VarChar(8)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sat_product_service_codes")
}

model SatTaxRegime {
  code        String   @id @db.VarChar(3)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sat_tax_regimes")
}

model SatCfdiUse {
  code        String   @id @db.VarChar(4)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sat_cfdi_uses")
}

model SatUnitOfMeasure {
  code        String   @id @db.VarChar(3)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sat_units_of_measure")
}

/// branchId null = precio base (aplica a toda sucursal sin override propio);
/// branchId no-null = override exclusivo de esa sucursal. La unicidad real de
/// (productId, name) por ámbito y de "un solo default por ámbito" la enforzan
/// índices únicos PARCIALES creados a mano en la migración
/// add_branch_scoped_product_prices (Prisma no soporta índices parciales):
/// product_price_global_name_idx, product_price_branch_name_idx,
/// product_default_price_global_idx, product_default_price_branch_idx.
/// El @@unique de abajo es una red de seguridad más laxa para el tipo
/// generado por Prisma Client, no la restricción de negocio real.
model ProductPrice {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  branchId    String   @map("branch_id")
  name        String   @db.VarChar(60)
  price       Decimal  @db.Decimal(12, 4)
  minQuantity Int      @default(1) @map("min_quantity")
  discountPct Decimal? @map("discount_pct") @db.Decimal(5, 2)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]
  quoteItems  QuoteItem[]
  returnItems ReturnItem[]

  @@unique([productId, branchId, name])
  @@index([productId])
  @@index([branchId])
  @@map("product_prices")
}

model ProductDosification {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String   @db.VarChar(60)
  numParts  Int      @map("num_parts")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]
  returnItems ReturnItem[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_dosifications")
}

model BranchInventory {
  id                     String    @id @default(uuid())
  branchId               String    @map("branch_id")
  productId              String    @map("product_id")
  quantity               Decimal   @default(0) @db.Decimal(14, 4)
  reservedQuantity       Decimal   @default(0) @map("reserved_quantity") @db.Decimal(14, 4)
  reorderPoint           Decimal   @default(0) @map("reorder_point") @db.Decimal(14, 4)
  updatedAt              DateTime  @updatedAt @map("updated_at")
  lastLowStockNotifiedAt DateTime? @map("last_low_stock_notified_at")

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_inventory")
}

model InventoryMovement {
  id                String   @id @default(uuid())
  branchId          String   @map("branch_id")
  productId         String   @map("product_id")
  movementAt        DateTime @map("movement_at")
  sequence          BigInt   @default(autoincrement())
  movementType      String   @map("movement_type") @db.VarChar(30)
  direction         String   @db.VarChar(4)
  quantity          Decimal  @db.Decimal(14, 4)
  unit              String   @db.VarChar(10)
  balanceAfter      Decimal  @map("balance_after") @db.Decimal(14, 4)
  unitCost          Decimal? @map("unit_cost") @db.Decimal(12, 4)
  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 4)
  customerId        String?  @map("customer_id")
  providerId        String?  @map("provider_id")
  folioId           String?  @map("folio_id")
  folioCode         String?  @map("folio_code") @db.VarChar(64)
  folioNumber       Int?     @map("folio_number")
  originFolioCode   String?  @map("origin_folio_code") @db.VarChar(40)
  originFolioNumber Int?     @map("origin_folio_number")
  sourceType        String   @map("source_type") @db.VarChar(20)
  sourceId          String   @map("source_id")
  status            String   @default("Aplicada") @db.VarChar(20)
  notes             String?  @db.Text
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  folio    Folio?    @relation(fields: [folioId], references: [id], onDelete: SetNull)

  @@index([branchId, productId, movementAt, sequence])
  @@index([sourceType, sourceId])
  @@map("inventory_movements")
}

model Customer {
  id                    String   @id @default(uuid())
  code                  String   @unique @db.VarChar(32)
  name                  String   @db.VarChar(120)
  rfc                   String?  @db.VarChar(13)
  legalName             String?  @map("legal_name") @db.VarChar(200)
  taxRegime             String?  @map("tax_regime") @db.VarChar(3)
  cfdiUse               String?  @map("cfdi_use") @db.VarChar(4)
  taxZipCode            String?  @map("tax_zip_code") @db.VarChar(5)
  email                 String?  @db.VarChar(120)
  phone                 String?  @db.VarChar(30)
  address               String?  @db.VarChar(300)
  contactName           String?  @map("contact_name") @db.VarChar(120)
  notes                 String?  @db.Text
  creditLimit           Decimal? @map("credit_limit") @db.Decimal(12, 4)
  currentBalance        Decimal  @default(0) @map("current_balance") @db.Decimal(12, 4)
  initialBalance        Decimal  @default(0) @map("initial_balance") @db.Decimal(12, 4)
  creditDays            Int      @default(30) @map("credit_days")
  isActive              Boolean  @default(true) @map("is_active")
  addressStreet         String?  @map("address_street") @db.VarChar(150)
  addressExteriorNumber String?  @map("address_exterior_number") @db.VarChar(20)
  addressInteriorNumber String?  @map("address_interior_number") @db.VarChar(20)
  addressNeighborhood   String?  @map("address_neighborhood") @db.VarChar(100)
  addressMunicipality   String?  @map("address_municipality") @db.VarChar(100)
  addressState          String?  @map("address_state") @db.VarChar(3)
  addressCountry        String?  @default("MEX") @map("address_country") @db.VarChar(3)
  addressZipCode        String?  @map("address_zip_code") @db.VarChar(5)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  sales     Sale[]
  quotes    Quote[]
  returns   Return[]
  payments  CustomerPayment[]
  invoices  Invoice[]
  movements InventoryMovement[]
  waybills  Waybill[]
  branches  CustomerBranch[]

  @@index([code])
  @@index([rfc])
  @@index([name])
  @@map("customers")
}

model CustomerBranch {
  customerId String   @map("customer_id")
  branchId   String   @map("branch_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([customerId, branchId])
  @@index([branchId])
  @@map("customer_branches")
}

model Sale {
  id                 String    @id @default(uuid())
  folioId            String    @map("folio_id")
  folioNumber        Int       @map("folio_number")
  folioCode          String    @map("folio_code") @db.VarChar(64)
  branchId           String    @map("branch_id")
  customerId         String?   @map("customer_id")
  cashierId          String    @map("cashier_id") @db.Uuid
  paymentMethodId    String    @map("payment_method_id")
  quoteId            String?   @map("quote_id")
  status             String    @db.VarChar(20)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 4)
  paymentStatus      String    @default("paid") @map("payment_status") @db.VarChar(10)
  subtotal           Decimal   @db.Decimal(14, 4)
  taxTotal           Decimal   @map("tax_total") @db.Decimal(14, 4)
  total              Decimal   @db.Decimal(14, 4)
  notes              String?   @db.Text
  dueDate            DateTime? @map("due_date")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  editedAt           DateTime? @map("edited_at")
  clientRequestId    String?   @unique @map("client_request_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  folio               Folio             @relation(fields: [folioId], references: [id], onDelete: Restrict)
  branch              Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier             User              @relation("UserSales", fields: [cashierId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  quote               Quote?            @relation("SaleFromQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  items               SaleItem[]
